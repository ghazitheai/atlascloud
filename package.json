{
  "name": "atlas-procurement",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "worker": "node --import tsx src/worker.ts",
    "admin:bootstrap": "node --import tsx scripts/bootstrap.ts",
    "admin:provision": "node --import tsx scripts/provision.ts",
    "admin:password": "node --import tsx scripts/password.ts",
    "format": "prettier --write src tests prisma/*.ts scripts/*.ts *.ts *.json docs/*.md README.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "decimal.js": "10.6.0",
    "next": "16.4.1",
    "nodemailer": "10.1.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "24.10.0",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.2",
    "tinypool": "2.1.2"
  }
}
