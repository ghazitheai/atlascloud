# Development only. Replace placeholders before using a shared environment.
DATABASE_URL=postgresql://atlas:change-local-db-password@db:5432/atlas
DIRECT_URL=postgresql://atlas:change-local-db-password@db:5432/atlas
APP_URL=http://localhost:3000
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-local-db-password
POSTGRES_DB=atlas
EMAIL_MODE=development
EMAIL_FROM=Atlas Development <dev@atlas.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Supply S3 credentials via server-only environment settings. Uploads stay blocked until clean malware scan.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Demo only. Remove these entirely from production. Supply your own long password.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
NEXT_TELEMETRY_DISABLED=1
